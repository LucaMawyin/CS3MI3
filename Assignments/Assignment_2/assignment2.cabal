cabal-version: 2.4
name: assignment2
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    R
    Eval

  build-depends: base >=4.17 && <5
  default-language: Haskell2010

test-suite assignment2-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    QuickCheck,
    assignment2,
    base >=4.17 && <5,

  default-language: Haskell2010